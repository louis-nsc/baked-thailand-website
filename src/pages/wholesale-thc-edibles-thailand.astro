---
import BaseLayout from '../layouts/BaseLayout.astro';
import { lineUrl } from '../data/navigation';

const title = 'Cannabis Edibles Wholesale Thailand | Partner with Baked Brand';
const description =
  "Wholesale Thai FDA-approved THC microdose cookies and caramels, nationwide supply. One of the few compliant edibles suppliers after Thailand's 2026 crackdown.";

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Cannabis edibles wholesale supply',
    provider: { '@type': 'LocalBusiness', name: 'Baked Brand Edibles in Thailand' },
    areaServed: { '@type': 'Country', name: 'Thailand' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bakedthailand.com/' },
      { '@type': 'ListItem', position: 2, name: 'Wholesale', item: 'https://bakedthailand.com/wholesale-thc-edibles-thailand/' },
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    {structuredData.map((sd) => <script type="application/ld+json" set:html={JSON.stringify(sd)} />)}
  </Fragment>

  <section class="bk-hero">
    <p class="bk-eyebrow">Wholesale</p>
    <h1>Wholesale Cannabis Edibles Thailand — Thai FDA-Approved, Nationwide Supply</h1>
    <p class="bk-sub">
      Roughly 40% of Thailand's cannabis shops have closed since 2025, many of
      them suppliers that