---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleBody from '../components/sections/ArticleBody.astro';
import { lineUrl } from '../data/navigation';

const title = 'Cannabis Edibles Wholesale Thailand | Partner with Baked Brand';
const description =
  "Wholesale Thai FDA-approved THC microdose cookies and caramels, nationwide supply. One of the few compliant edibles suppliers after Thailand's 2026 crackdown.";

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Cannabis edibles wholesale supply',
    provider: { '@type': 'LocalBusiness', name: 'Baked Brand Edibles in Thailand' },
    areaServed: { '@type': 'Country', name: 'Thailand' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bakedthailand.com/' },
      { '@type': 'ListItem', position: 2, name: 'Wholesale', item: 'https://bakedthailand.com/wholesale-thc-edibles-thailand/' },
    ],
  },
];

const sections = [
  {
    h2: "Why wholesale with Baked Brand?",
    html: "Baked Brand is Thailand's first and only Thai FDA-approved microdose THC edibles brand. With roughly 40% of Thailand's cannabis shops closing since 2025, FDA-compliant products are increasingly important for venues that want to stay operational.",
  },
  {
    h2: "Products available for wholesale",
    html: "We supply our microdose THC cookies and caramels in wholesale quantities. Each unit contains up to 1.6mg THC -- lab tested, consistently dosed. Available in Chiang Mai for direct pickup or nationwide delivery.",
  },
  {
    h2: "Who we work with",
    html: "We partner with cafes, hotels, bars, spas, dispensaries, and event venues across Thailand. We also supply tour operators, nightlife venues, and wellness retreats. <a href='/th/business/'>See our B2B venue guides &rarr;</a>",
  },
  {
    h2: "Minimum orders and pricing",
    html: `Contact us on LINE to discuss wholesale pricing, minimum order quantities, and delivery terms. We work with both small independent venues and larger hospitality groups. <a href="${lineUrl}" target="_blank" rel="noopener">Message us on LINE &rarr;</a>`,
  },
  {
    h2: "Thai FDA approved -- what that means for your business",
    html: "Stocking products with Thai FDA approval signals compliance and responsibility to customers. Our products are made in our own factory in Chiang Mai using cannabis developed by Maejo University -- not extracts. <a href='/microdose-edibles-legal-in-thailand/'>Learn more about legality &rarr;</a>",
  },
];
---

<BaseLayout title={title} description={description} canonicalUrl="https://bakedthailand.com/wholesale-thc-edibles-thailand/">
  <Fragment slot="head">
    {structuredData.map((sd) => <script type="application/ld+json" set:html={JSON.stringify(sd)} />)}
  </Fragment>
  <ArticleBody
    eyebrow="B2B WHOLESALE"
    h1="Wholesale Cannabis Edibles Thailand -- Thai FDA Approved, Nationwide Supply"
    sub="Supply your venue with Thailand's only Thai FDA-approved microdose THC edibles. Cookies and caramels, up to 1.6mg THC, lab-tested."
    sections={sections}
    ctaLabel="Enquire on LINE"
  />
</BaseLayout>
