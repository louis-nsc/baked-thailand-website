---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoPageBody from '../components/sections/GeoPageBody.astro';
import FeaturedIn from '../components/patterns/FeaturedIn.astro';
import { geoPages } from '../data/geoPages';

const page = geoPages.find((p) => p.slug === 'cannabis-edibles-koh-phangan')!;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'THC microdose edible delivery',
    provider: { '@type': 'LocalBusiness', name: 'Baked Brand Edibles in Thailand' },
    areaServed: page.city,
    description: page.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bakedthailand.com/' },
      { '@type': 'ListItem', position: 2, name: `Cannabis Edibles in ${page.city}`, item: `https://bakedthailand.com/${page.slug}/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How long does it take to feel the effects?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Edibles take longer than smoking — usually 45 to 90 minutes to kick in, and the effects last longer too. Start with one piece and wait before having more.',
        },
      },
      {
        '@type': 'Question',
        name: `Is it legal to order this in ${page.city}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `Baked Brand products hold Thai FDA approval, so yes — ordering and delivery in ${page.city} is fully legal for adults aged 20 and over.`,
        },
      },
    ],
  },
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  structuredData={structuredData}
  canonicalUrl={`https://bakedthailand.com/${page.slug}/`}
>
  <GeoPageBody page={page} />
  <FeaturedIn />
</BaseLayout>
