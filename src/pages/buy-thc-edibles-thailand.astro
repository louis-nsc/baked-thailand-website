---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleBody from '../components/sections/ArticleBody.astro';

const title = 'How to Buy THC Edibles in Thailand Legally & Safely (2026)';
const description =
  'A complete guide to buying THC edibles legally in Thailand. What Thai FDA compliance means, where to buy safely, and how to dose.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: 'https://bakedthailand.com/images/logo-color.png',
  datePublished: '2026-07-17',
  author: { '@type': 'Organization', name: 'Baked Brand Edibles in Thailand' },
  publisher: {
    '@type': 'Organization',
    name: 'Baked Brand Edibles in Thailand',
    logo: { '@type': 'ImageObject', url: 'https://bakedthailand.com/images/logo-color.png' },
  },
};

const sections = [
  {
    h2: 'What "Thai FDA-approved" actually means',
    html: 'It means the product has gone through Thailand\'s medical/approved-product cannabis framework — lab-tested, licensed supply chain, clearly labeled THC content. That\'s a different category from unregulated recreational products.',
  },
  {
    h2: 'How to buy safely',
    html: 'Check for lab testing and a clear THC-per-piece figure before buying anything. Baked\'s cookies and caramels are up to 1.6mg THC per piece, Thai FDA-approved, and delivered nationwide -- order direct via LINE.',
  },
  {
    h2: 'Why this matters more than usual right now',
    html: 'Roughly since mid-2024, Thai authorities have been cracking down on unregulated cannabis products. Buying from an FDA-approved source is the clearest way to stay on the right side of these changes.',
  },
  {
    h2: 'Dosage guide for first-timers',
    html: 'Start with half a piece (about 0.8mg THC) and wait 90 minutes before having more. Effects from edibles take longer to arrive than smoking, and last longer once they do.',
  },
];
---

<BaseLayout title={title} description={description} structuredData={structuredData} canonicalUrl={`https://bakedthailand.com/${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}/`}>
  <ArticleBody
    eyebrow="THAI FDA APPROVED"
    h1={title}
    sub="Thailand's only Thai FDA-approved microdose THC edibles. Up to 1.6mg THC per piece, lab-tested, made in our own factory."
    sections={sections}
    ctaLabel="Order on LINE"
    shopeeLabel="Learn More"
  />
</BaseLayout>
