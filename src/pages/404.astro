---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "404 — Page Not Found | Baked Brand Thailand";
const description = "This page doesn't exist. But our LINE does — order Baked Brand THC microdose cookies direct via LINE.";
const lineUrl = 'https://page.line.me/baked';
---

<BaseLayout title={title} description={description}>
  <main class="not-found">
    <div class="container">

      <div class="logo-wrap">
        <img src="/images/logo-color.png" alt="Baked Brand" width="56" height="56" />
      </div>

      <p class="eyebrow">Error 404</p>

      <h1>This page doesn't exist.</h1>
      <p class="sub">Our LINE does.</p>

      <p class="body-copy">
        Order direct, ask about stockists, wholesale, or just say hi —
        we're on LINE and we actually reply.
      </p>

      <div class="qr-block">
        <img
          src="/images/line-qr.png"
          alt="Scan to open Baked Brand on LINE"
          class="qr-img"
          width="160"
          height="160"
        />
        <p class="qr-label">Scan with your camera</p>
      </div>

      <a href={lineUrl} target="_blank" rel="noopener noreferrer" class="btn-line">
        <svg class="line-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
        </svg>
        Open in LINE
      </a>

      <div class="fallback-links">
        <a href="/">← Back to homepage</a>
        <span class="divider">·</span>
        <a href="/edibles/">Shop edibles</a>
      </div>

    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem 5rem;
    background: var(--cream, #f9f6f0);
    text-align: center;
  }

  .container {
    max-width: 420px;
    margin: 0 auto;
  }

  .logo-wrap {
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
  }

  .logo-wrap img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    opacity: 0.5;
  }

  .eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #aaa;
    font-weight: 600;
    margin: 0 0 0.75rem;
  }

  h1 {
    font-family: 'Thasadith', serif;
    font-size: clamp(1.75rem, 5vw, 2.25rem);
    color: var(--dark, #1a1a1a);
    margin: 0 0 0.3rem;
    line-height: 1.2;
  }

  .sub {
    font-family: 'Thasadith', serif;
    font-size: clamp(1.4rem, 4vw, 1.75rem);
    color: var(--green, #2d5a27);
    margin: 0 0 1.25rem;
    line-height: 1.2;
  }

  .body-copy {
    font-size: 0.95rem;
    color: #666;
    line-height: 1.65;
    margin: 0 0 2rem;
    max-width: 340px;
    margin-left: auto;
    margin-right: auto;
  }

  /* QR code */
  .qr-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .qr-img {
    width: 160px;
    height: 160px;
    border-radius: 10px;
    border: 3px solid var(--green, #2d5a27);
    padding: 6px;
    background: var(--cream, #f9f6f0);
    image-rendering: pixelated;
  }

  .qr-label {
    font-size: 0.75rem;
    color: #aaa;
    margin: 0;
    letter-spacing: 0.04em;
  }

  /* LINE button */
  .btn-line {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    background: #06c755;
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.85rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    width: 100%;
    max-width: 280px;
    margin-bottom: 2rem;
    transition: opacity 0.15s;
    letter-spacing: 0.01em;
  }

  .btn-line:hover {
    opacity: 0.88;
  }

  .line-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  /* fallback links */
  .fallback-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-size: 0.85rem;
  }

  .fallback-links a {
    color: var(--green, #2d5a27);
    text-decoration: none;
  }

  .fallback-links a:hover {
    text-decoration: underline;
  }

  .divider {
    color: #ccc;
  }
</style>
