const title = 'Is Cannabis Still Legal in Thailand? 2026 Crackdown Explained';
const description =
  "Thailand's 2026 crackdown shut down thousands of cannabis shops — but Baked's Thai FDA-approved microdose edibles remain 100% legal.";

const sections = [
  {
    h2: "What's Actually Restricted vs. What's Legal",
    html: "Recreational cannabis flower, high-potency edibles, vapes, and extracts like rosin and hash — all sold through unlicensed shops — are what's being targeted. Thai FDA-approved microdose edibles — like Baked's cookies and caramels, formulated at up to 1.6mg THC per piece and lab-tested every batch — are produced under Thailand's medical/approved-product framework, not the recreational market the crackdown is aimed at, and remain unaffected. That distinction is the whole story: it's not about THC being newly illegal, it's about which supply chains and product categories are compliant.",
  },
  {
