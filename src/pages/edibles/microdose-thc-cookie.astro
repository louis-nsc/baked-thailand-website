---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Baked Brand Microdose THC Cookie | Full-Spectrum | Thailand';
const description =
  "Thailand's first FDA-approved microdose cannabis cookie -- 1.6mg full-spectrum THC, nitrogen-flushed packaging, sourced from Maejo University. Order direct via LINE.";

const lineUrl = 'https://page.line.me/baked';

const faqs = [
  {
    q: 'Will one microdose cookie get me too high?',
    a: 'At up to 1.6mg THC per cookie, Baked is a microdose edible formulated for low-dose consumers. Most first-time users feel a mild, manageable uplift. Effects vary by body weight, metabolism, and tolerance -- always start with one and wait at least 60 minutes before considering a second.',
  },
  {
    q: 'How long does it take to feel the effects?',
    a: 'Edibles take 30--60 minutes to absorb through the digestive system, though a full stomach can delay this further. Effects typically last 2--4 hours. Unlike smoking, the onset is gradual -- do not eat more before the first has had time to work.',
  },
  {
    q: "What's the difference between full spectrum and distillate?",
    a: "Distillate is a highly processed extract that isolates THC and removes most other plant compounds. Full-spectrum products preserve the natural compound profile of the plant, including cannabinoids, terpenes, and flavonoids. We make a full-spectrum infusion using fan leaves from Maejo University and use that infusion in every cookie. We don't use distillate.",
  },
  {
    q: 'Is this product legal in Thailand?',
    a: "Yes. Baked holds Thai FDA registration No. 50-2-03459-6-0017 and complies with Thailand's regulations on cannabis-infused food products, including the 1.6mg THC per unit limit. We are Thailand's first FDA-approved cannabis cookie.",
  },
  {
    q: 'Can I mix this with alcohol?',
    a: "We strongly advise against combining cannabis edibles with alcohol. Both substances affect the central nervous system and their combination can amplify effects unpredictably.",
  },
  {
    q: 'Who should not eat this product?',
    a: "This product is not suitable for: anyone under 20 years of age, pregnant or breastfeeding women, people with a history of psychosis or severe anxiety, or anyone taking medications that interact with cannabis. If you are unsure, consult a healthcare professional before consuming.",
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Baked Brand Microdose THC Cookie -- Original Chocolate Chip',
    description,
    image: 'https://bakedthailand.com/images/cookies/cannabis-baked-30pack.jpg',
    brand: { '@type': 'Brand', name: 'Baked Brand' },
    offers: [
      {
        '@type': 'Offer',
        price: '300',
        priceCurrency: 'THB',
        availability: 'https://schema.org/InStock',
        description: '6-pack (฿50 per cookie)',
      },
      {
        '@type': 'Offer',
        price: '1450',
        priceCurrency: 'THB',
        availability: 'https://schema.org/InStock',
        description: '30-pack display box (฿48 per cookie)',
      },
    ],
    additionalProperty: [
      { '@type': 'PropertyValue', name: 'THC per unit', value: 'Up to 1.6mg' },
      { '@type': 'PropertyValue', name: 'FDA Registration', value: '50-2-03459-6-0017' },
      { '@type': 'PropertyValue', name: 'Spectrum', value: 'Full spectrum' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bakedthailand.com/' },
      { '@type': 'ListItem', position: 2, name: 'Edibles', item: 'https://bakedthailand.com/edibles/' },
      { '@type': 'ListItem', position: 3, name: 'Microdose THC Cookie', item: 'https://bakedthailand.com/edibles/microdose-thc-cookie/' },
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <slot name="head" slot="head">
    {structuredData.map((sd) => (
      <script type="application/ld+json" set:html={JSON.stringify(sd)} />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Thasadith:ital,wght@0,400;0,700;1,400&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      /* ═══════════════════════════════════════════════
         MICRODOSE COOKIE PRODUCT PAGE
         Baked Brand Design System -- Deep Green / Gold
         ═══════════════════════════════════════════════ */
      :root {
        --green:        #335940;
        --green-deep:   #243f2d;
        --green-mid:    #4a7a5e;
        --gold:         #e8aa00;
        --gold-light:   #f5c832;
        --gold-pale:    #fdf4d4;
        --dark:         #111a14;
        --dark-mid:     #1c2d22;
        --cream:        #fafaf7;
        --cream-warm:   #f4f1e8;
        --text:         #1e2e23;
        --text-mid:     #3d5244;
        --text-muted:   #6b8572;
        --border:       #cddbd2;
        --border-light: #e4ede7;
      }

      .pd-wrap *, .pd-wrap *::before, .pd-wrap *::after { box-sizing: border-box; }
      .pd-wrap {
        font-family: 'Noto Sans Thai', sans-serif;
        color: var(--text);
        font-size: 16px;
        line-height: 1.6;
      }
      .pd-wrap h1, .pd-wrap h2, .pd-wrap h3 {
        font-family: 'Thasadith', sans-serif;
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.02em;
      }
      .pd-label {
        font-family: 'Thasadith', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: var(--gold);
        letter-spacing: 0.01em;
        display: block;
        margin-bottom: 10px;
      }
      .pd-label-green { color: var(--green-mid); }
      .pd-label-light { color: var(--gold-light); }

      /* ── BUTTONS ── */
      .pd-btn {
        display: inline-block;
        font-family: 'Noto Sans Thai', sans-serif;
        font-weight: 700;
        font-size: 14px;
        padding: 14px 32px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: transform 0.18s, box-shadow 0.18s;
        text-decoration: none;
        letter-spacing: 0.01em;
      }
      .pd-btn:hover { transform: translateY(-1px); }
      .pd-btn-gold { background: var(--gold); color: var(--dark); }
      .pd-btn-gold:hover { background: var(--gold-light); box-shadow: 0 6px 20px rgba(232,170,0,0.4); color: var(--dark); }
      .pd-btn-ghost { background: transparent; color: var(--cream); border: 1.5px solid rgba(255,255,255,0.3); }
      .pd-btn-ghost:hover { border-color: rgba(255,255,255,0.7); color: var(--cream); }
      .pd-btn-outline { background: transparent; color: var(--green); border: 1.5px solid var(--green); }
      .pd-btn-outline:hover { background: var(--green); color: var(--cream); }

      /* ── HERO ── */
      .pd-hero {
        background: var(--dark);
        min-height: 680px;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
      }
      .pd-hero::before {
        content: '';
        position: absolute;
        right: -160px; top: 50%;
        transform: translateY(-50%);
        width: 720px; height: 720px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(51,89,64,0.45) 0%, transparent 68%);
        pointer-events: none;
      }
      .pd-hero-inner {
        max-width: 1240px;
        width: 100%;
        margin: 0 auto;
        padding: 100px 56px;
        display: flex;
        align-items: center;
        gap: 72px;
        position: relative;
        z-index: 1;
      }
      .pd-hero-text { flex: 1 1 420px; }
      .pd-hero-eyebrow {
        font-family: 'Thasadith', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: var(--gold);
        margin-bottom: 24px;
        display: block;
      }
      .pd-hero-h1 {
        font-size: clamp(52px, 7vw, 88px);
        color: var(--cream);
        margin: 0 0 20px;
        line-height: 0.95;
      }
      .pd-hero-h1 span { color: var(--gold); }
      .pd-flavor-tag {
        display: inline-block;
        font-size: 12px;
        font-weight: 700;
        font-family: 'Thasadith', sans-serif;
        color: var(--dark);
        background: var(--gold);
        padding: 4px 14px;
        border-radius: 20px;
        letter-spacing: 0.03em;
        margin: -4px 0 24px;
      }
      .pd-hero-body {
        font-size: 17px;
        color: rgba(250,250,247,0.65);
        line-height: 1.65;
        margin: 0 0 40px;
        max-width: 400px;
      }
      .pd-specs {
        display: flex;
        margin-bottom: 40px;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 6px;
        overflow: hidden;
        max-width: 480px;
      }
      .pd-spec {
        flex: 1;
        padding: 14px 18px;
        border-right: 1px solid rgba(255,255,255,0.08);
      }
      .pd-spec:last-child { border-right: none; }
      .pd-spec-label {
        font-size: 10px;
        color: rgba(250,250,247,0.3);
        display: block;
        margin-bottom: 4px;
        font-weight: 600;
        letter-spacing: 0.04em;
      }
      .pd-spec-val {
        font-family: 'Thasadith', sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: var(--cream);
      }
      .pd-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
      .pd-hero-visual {
        flex: 0 0 460px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
      }
      .pd-hero-img {
        width: 100%;
        max-width: 440px;
        border-radius: 16px;
        object-fit: cover;
        display: block;
        filter: drop-shadow(0 24px 64px rgba(0,0,0,0.6));
      }
      .pd-price-tag {
        position: absolute;
        bottom: 20px; right: 0;
        background: var(--gold);
        color: var(--dark);
        font-family: 'Thasadith', sans-serif;
        font-weight: 700;
        font-size: 13px;
        padding: 8px 18px;
        border-radius: 4px;
        white-space: nowrap;
      }

      /* ── TRUST BAR ── */
      .pd-trust { background: var(--cream); border-bottom: 1px solid var(--border-light); }
      .pd-trust-inner {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 56px;
        display: flex;
        flex-wrap: wrap;
      }
      .pd-trust-item {
        flex: 1 1 180px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-right: 1px solid var(--border-light);
      }
      .pd-trust-item:last-child { border-right: none; }
      .pd-trust-icon {
        width: 36px; height: 36px;
        background: var(--green);
        border-radius: 6px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
      }
      .pd-trust-icon svg { width: 18px; height: 18px; stroke: #fff; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .pd-trust-title { font-weight: 700; font-size: 13px; color: var(--text); display: block; margin-bottom: 2px; }
      .pd-trust-sub { font-size: 11px; color: var(--text-muted); }

      /* ── GALLERY ── */
      .pd-gallery { background: var(--cream-warm); padding: 88px 0; }
      .pd-gallery-inner { max-width: 1240px; margin: 0 auto; padding: 0 56px; }
      .pd-gallery-head { text-align: center; margin-bottom: 48px; }
      .pd-gallery-head h2 { font-size: clamp(28px, 3.5vw, 40px); color: var(--text); margin: 8px 0 0; }
      .pd-events-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        grid-template-rows: 380px;
        gap: 12px;
      }
      .pd-event-cell { border-radius: 10px; overflow: hidden; }
      .pd-event-cell img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s; }
      .pd-event-cell:hover img { transform: scale(1.03); }
      .pd-product-photos { background: var(--cream-warm); padding: 80px 0; }
      .pd-photo-grid {
        display: grid;
        grid-template-columns: 1fr 300px;
        grid-template-rows: 320px;
        gap: 12px;
      }
      .pd-photo-cell { border-radius: 10px; overflow: hidden; }
      .pd-photo-cell img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s; }
      .pd-photo-cell:hover img { transform: scale(1.03); }
      .pd-photo-side { grid-column: 2; display: flex; flex-direction: column; gap: 12px; }
      .pd-photo-side .pd-photo-cell { flex: 1; }

      /* ── SECTION ── */
      .pd-section { max-width: 1240px; margin: 0 auto; padding: 96px 56px; }
      .pd-section-head { margin-bottom: 52px; }
      .pd-section-head h2 { font-size: clamp(28px, 3.5vw, 44px); color: var(--text); margin: 8px 0 14px; }
      .pd-section-head p { font-size: 17px; color: var(--text-mid); line-height: 1.65; max-width: 560px; margin: 0; }

      /* ── PRICING ── */
      .pd-pricing-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; max-width: 760px; margin: 0 auto; }
      .pd-price-card {
        background: #fff;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        padding: 36px 32px;
        position: relative;
        transition: border-color 0.2s, box-shadow 0.2s;
      }
      .pd-price-card:hover { border-color: var(--green-mid); box-shadow: 0 4px 24px rgba(51,89,64,0.1); }
      .pd-price-card.featured { border-color: var(--gold); box-shadow: 0 4px 32px rgba(232,170,0,0.15); }
      .pd-price-badge {
        position: absolute; top: -11px; left: 50%; transform: translateX(-50%);
        background: var(--gold); color: var(--dark);
        font-size: 10px; font-weight: 700;
        font-family: 'Thasadith', sans-serif;
        padding: 4px 16px; border-radius: 20px; white-space: nowrap; letter-spacing: 0.04em;
      }
      .pd-price-qty { font-family: 'Thasadith', sans-serif; font-size: 80px; font-weight: 700; color: var(--text); line-height: 0.9; margin-bottom: 4px; }
      .pd-price-unit { font-size: 12px; color: var(--text-muted); font-weight: 600; margin-bottom: 20px; letter-spacing: 0.03em; }
      .pd-price-amount { font-family: 'Thasadith', sans-serif; font-size: 32px; font-weight: 700; color: var(--green); }
      .pd-price-per { font-size: 13px; color: var(--text-muted); margin-top: 2px; margin-bottom: 24px; }
      .pd-price-divider { border: none; border-top: 1px solid var(--border-light); margin: 24px 0; }
      .pd-price-feat { font-size: 14px; color: var(--text-mid); display: flex; gap: 8px; align-items: flex-start; margin-bottom: 8px; line-height: 1.4; }
      .pd-price-check { color: var(--green); font-weight: 700; flex-shrink: 0; }
      .pd-price-cta {
        display: block; width: 100%; margin-top: 24px;
        background: var(--dark); color: var(--cream);
        padding: 13px 20px; border-radius: 6px;
        font-size: 14px; font-weight: 700; border: none; cursor: pointer;
        font-family: 'Noto Sans Thai', sans-serif;
        text-align: center; text-decoration: none;
        transition: background 0.2s;
      }
      .pd-price-card.featured .pd-price-cta { background: var(--gold); color: var(--dark); }
      .pd-price-cta:hover { background: var(--green); color: var(--cream); }
      .pd-price-card.featured .pd-price-cta:hover { background: var(--gold-light); color: var(--dark); }
      .pd-wholesale {
        margin-top: 32px;
        background: var(--cream-warm);
        border: 1.5px solid var(--border);
        border-radius: 10px;
        padding: 28px 36px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
      }
      .pd-wholesale strong { font-family: 'Thasadith', sans-serif; font-size: 18px; color: var(--text); display: block; margin-bottom: 4px; }
      .pd-wholesale span { font-size: 14px; color: var(--text-mid); max-width: 540px; display: block; line-height: 1.55; }

      /* ── DARK SECTION ── */
      .pd-dark { background: var(--dark); padding: 96px 0; position: relative; overflow: hidden; }
      .pd-dark::after {
        content: '';
        position: absolute; top: -100px; right: -100px;
        width: 500px; height: 500px; border-radius: 50%;
        background: radial-gradient(circle, rgba(51,89,64,0.3) 0%, transparent 65%);
        pointer-events: none;
      }
      .pd-dark-inner { max-width: 1240px; margin: 0 auto; padding: 0 56px; position: relative; }
      .pd-dark h2 { color: var(--cream); font-size: clamp(28px, 3.5vw, 44px); margin: 8px 0 16px; }
      .pd-dark p.intro { font-size: 17px; color: rgba(250,250,247,0.6); line-height: 1.65; max-width: 580px; margin: 0 0 52px; }

      /* Compare table */
      .pd-compare { width: 100%; border-collapse: separate; border-spacing: 0; }
      .pd-compare thead th { padding: 16px 24px; text-align: left; font-family: 'Thasadith', sans-serif; font-size: 13px; font-weight: 700; }
      .pd-compare thead th:first-child { color: rgba(250,250,247,0.3); width: 26%; }
      .pd-compare thead th.col-dis { color: rgba(250,250,247,0.4); background: rgba(255,255,255,0.03); border-radius: 8px 8px 0 0; }
      .pd-compare thead th.col-baked { color: var(--gold); background: rgba(232,170,0,0.08); border-radius: 8px 8px 0 0; border-top: 2px solid rgba(232,170,0,0.4); }
      .pd-compare tbody td { padding: 14px 24px; font-size: 14px; border-bottom: 1px solid rgba(255,255,255,0.05); line-height: 1.5; vertical-align: top; }
      .pd-compare tbody td:first-child { color: rgba(250,250,247,0.5); font-weight: 600; }
      .pd-compare tbody td.col-dis { background: rgba(255,255,255,0.025); color: rgba(250,250,247,0.4); }
      .pd-compare tbody td.col-baked { background: rgba(232,170,0,0.05); color: var(--cream); border-left: 1px solid rgba(232,170,0,0.15); border-right: 1px solid rgba(232,170,0,0.15); }
      .pd-compare tbody tr:last-child td.col-dis { border-radius: 0 0 8px 8px; border-bottom: none; }
      .pd-compare tbody tr:last-child td.col-baked { border-radius: 0 0 8px 8px; border-bottom: 2px solid rgba(232,170,0,0.4); }
      .icon-yes { color: var(--gold); }
      .icon-no { color: rgba(250,250,247,0.2); }
      .pd-entourage {
        margin-top: 48px;
        background: rgba(232,170,0,0.07);
        border: 1px solid rgba(232,170,0,0.2);
        border-radius: 10px;
        padding: 36px;
        max-width: 680px;
      }
      .pd-entourage h3 { font-size: 20px; color: var(--gold-light); margin: 0 0 12px; }
      .pd-entourage p { font-size: 15px; color: rgba(250,250,247,0.65); line-height: 1.7; margin: 0; }

      /* ── SOURCING ── */
      .pd-sourcing-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
      .pd-sourcing-text h2 { font-size: clamp(28px, 3.5vw, 40px); margin: 8px 0 20px; }
      .pd-sourcing-text p { font-size: 16px; color: var(--text-mid); line-height: 1.65; margin: 0 0 20px; }
      .pd-sourcing-quote {
        font-family: 'Thasadith', sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.4;
        border-left: 3px solid var(--gold);
        padding-left: 20px;
        margin: 28px 0;
        font-style: italic;
      }
      .pd-sourcing-stats { display: flex; flex-direction: column; gap: 24px; }
      .pd-stat-row { display: flex; gap: 16px; align-items: flex-start; }
      .pd-stat-icon {
        width: 44px; height: 44px;
        background: var(--green);
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
      }
      .pd-stat-icon svg { width: 20px; height: 20px; stroke: #fff; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .pd-stat-title { font-weight: 700; font-size: 14px; color: var(--text); display: block; margin-bottom: 2px; }
      .pd-stat-desc { font-size: 13px; color: var(--text-muted); line-height: 1.5; }

      /* ── DOSING ── */
      .pd-dosing-steps {
        display: grid; grid-template-columns: repeat(4, 1fr);
        gap: 2px; margin-top: 52px;
        background: var(--border-light); border: 1px solid var(--border-light);
        border-radius: 10px; overflow: hidden;
      }
      .pd-dose-step { background: #fff; padding: 32px 28px; }
      .pd-dose-step:first-child { border-radius: 10px 0 0 10px; }
      .pd-dose-step:last-child { border-radius: 0 10px 10px 0; }
      .pd-dose-num { font-family: 'Thasadith', sans-serif; font-size: 44px; font-weight: 700; color: rgba(51,89,64,0.15); line-height: 1; margin-bottom: 14px; }
      .pd-dose-title { font-family: 'Thasadith', sans-serif; font-weight: 700; font-size: 16px; color: var(--text); margin-bottom: 8px; }
      .pd-dose-body { font-size: 14px; color: var(--text-mid); line-height: 1.6; }
      .pd-dosing-note {
        margin-top: 32px;
        background: var(--cream-warm);
        border-left: 3px solid var(--green);
        border-radius: 0 8px 8px 0;
        padding: 18px 24px;
        font-size: 14px; color: var(--text-mid); line-height: 1.65; max-width: 700px;
      }

      /* ── PRESS ── */
      .pd-press-logos { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 36px; }
      .pd-press-chip {
        border: 1px solid var(--border); border-radius: 6px; padding: 12px 24px;
        color: var(--text-muted); background: #fff;
        transition: border-color 0.2s, opacity 0.2s;
        display: flex; align-items: center; justify-content: center; min-width: 100px;
      }
      .pd-press-chip:hover { border-color: var(--green-mid); opacity: 0.75; }
      .pd-press-pull {
        background: var(--cream-warm); border-radius: 10px; padding: 32px 40px;
        border-left: 3px solid var(--gold); max-width: 600px;
      }
      .pd-press-pull blockquote { font-family: 'Thasadith', sans-serif; font-size: 20px; font-weight: 700; color: var(--text); line-height: 1.4; margin: 0 0 12px; font-style: italic; }
      .pd-press-pull cite { font-size: 12px; color: var(--text-muted); font-style: normal; font-weight: 600; letter-spacing: 0.03em; }

      /* ── REVIEWS ── */
