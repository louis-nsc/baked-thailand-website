---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Cannabis Gummies | Baked Brand Thailand';
const description =
  'Cannabis gummies in Thailand -- what they are, how they work, and what to look for when buying. Baked Brand gummies coming soon.';

const lineUrl = 'https://page.line.me/baked';

const faqs = [
  {
    q: 'Are cannabis gummies legal in Thailand?',
    a: "Cannabis-infused food products are legal in Thailand provided they meet Thai FDA requirements, including a maximum of 1.6mg THC per unit. Products sold in Thailand should carry Thai FDA registration. Always check for a registration number before purchasing any cannabis edible.",
  },
  {
    q: 'How long do cannabis gummies take to work?',
    a: "Edibles, including gummies, are absorbed through the digestive system. Onset typically takes 30--60 minutes, though this can be delayed by a full stomach. Effects generally last 2--4 hours. The most common mistake is eating a second gummy before the first one has had time to take effect.",
  },
  {
    q: "What's the right dose for a cannabis gummy?",
    a: "For first-time users, 1--2mg of THC is a sensible starting point -- often called a microdose. Thailand's regulatory limit is 1.6mg THC per unit, which keeps Thai-made cannabis edibles firmly in microdose territory. Wait at least 60 minutes before considering a second piece.",
  },
  {
    q: "What is full-spectrum cannabis and why does it matter?",
    a: "Full-spectrum means the product preserves the natural compound profile of the cannabis plant -- cannabinoids, terpenes, and flavonoids -- rather than isolating just THC. Many researchers believe these compounds interact synergistically in what is called the entourage effect. Baked products use a full-spectrum infusion made from fan leaves sourced from Maejo University.",
  },
  {
    q: 'How are cannabis gummies different from cannabis cookies?',
    a: "Both are eaten edibles with similar onset times and dosing considerations. Gummies are typically gelatin- or pectin-based confections with a chewy texture, while cookies are baked goods. The key variables are the dosing accuracy, the type of cannabis extract used, and whether the product is Thai FDA-approved. Baked currently produces FDA-approved microdose cookies and caramels, with gummies in development.",
  },
  {
    q: 'Can I mix cannabis gummies with alcohol?',
    a: "We strongly advise against combining cannabis edibles of any kind with alcohol. Both affect the central nervous system and their combination can amplify effects unpredictably.",
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bakedthailand.com/' },
      { '@type': 'ListItem', position: 2, name: 'Edibles', item: 'https://bakedthailand.com/edibles/' },
      { '@type': 'ListItem', position: 3, name: 'Cannabis Gummies', item: 'https://bakedthailand.com/edibles/cannabis-gummies/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Cannabis Gummies in Thailand',
    description,
    author: { '@type': 'Organization', name: 'Baked Brand' },
    publisher: {
      '@type': 'Organization',
      name: 'Baked Brand',
      logo: { '@type': 'ImageObject', url: 'https://bakedthailand.com/images/baked-logo.png' },
    },
    mainEntityOfPage: 'https://bakedthailand.com/edibles/cannabis-gummies/',
  },
];
---

<BaseLayout title={title} description={description} canonicalUrl="https://bakedthailand.com/edibles/cannabis-gummies/">
  <slot name="head" slot="head">
    {structuredData.map((sd) => (
      <script type="application/ld+json" set:html={JSON.stringify(sd)} />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Thasadith:ital,wght@0,400;0,700;1,400&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      /* ═══════════════════════════════════════════════
         CANNABIS GUMMIES PAGE
         Baked Brand Design System
         ═══════════════════════════════════════════════ */
      :root {
        --green:        #335940;
        --green-deep:   #243f2d;
        --green-mid:    #4a7a5e;
        --gold:         #e8aa00;
        --gold-light:   #f5c832;
        --gold-pale:    #fdf4d4;
        --dark:         #111a14;
        --dark-mid:     #1c2d22;
        --cream:        #fafaf7;
        --cream-warm:   #f4f1e8;
        --text:         #1e2e23;
        --text-mid:     #3d5244;
        --text-muted:   #6b8572;
        --border:       #cddbd2;
        --border-light: #e4ede7;
      }

      .gm-wrap *, .gm-wrap *::before, .gm-wrap *::after { box-sizing: border-box; }
      .gm-wrap {
        font-family: 'Noto Sans Thai', sans-serif;
        color: var(--text);
        font-size: 16px;
        line-height: 1.6;
      }
      .gm-wrap h1, .gm-wrap h2, .gm-wrap h3 {
        font-family: 'Thasadith', sans-serif;
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.02em;
      }
      .gm-label {
        font-family: 'Thasadith', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: var(--gold);
        letter-spacing: 0.01em;
        display: block;
        margin-bottom: 10px;
      }
      .gm-label-green { color: var(--green-mid); }
      .gm-label-light { color: var(--gold-light); }

      /* ── BUTTONS ── */
      .gm-btn {
        display: inline-block;
        font-family: 'Noto Sans Thai', sans-serif;
        font-weight: 700;
        font-size: 14px;
        padding: 14px 32px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: transform 0.18s, box-shadow 0.18s;
        text-decoration: none;
        letter-spacing: 0.01em;
      }
      .gm-btn:hover { transform: translateY(-1px); }
      .gm-btn-gold { background: var(--gold); color: var(--dark); }
      .gm-btn-gold:hover { background: var(--gold-light); box-shadow: 0 6px 20px rgba(232,170,0,0.4); color: var(--dark); }
      .gm-btn-ghost { background: transparent; color: var(--cream); border: 1.5px solid rgba(255,255,255,0.3); }
      .gm-btn-ghost:hover { border-color: rgba(255,255,255,0.7); color: var(--cream); }
      .gm-btn-outline { background: transparent; color: var(--green); border: 1.5px solid var(--green); }
      .gm-btn-outline:hover { background: var(--green); color: var(--cream); }

      /* ── COMING SOON BANNER ── */
      .gm-coming-soon {
        background: var(--gold);
        padding: 14px 24px;
        text-align: center;
      }
      .gm-coming-soon p {
        margin: 0;
        font-family: 'Thasadith', sans-serif;
        font-weight: 700;
        font-size: 14px;
        color: var(--dark);
        letter-spacing: 0.01em;
      }
      .gm-coming-soon a {
        color: var(--dark);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      /* ── HERO ── */
      .gm-hero {
        background: var(--dark);
        min-height: 580px;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
      }
      .gm-hero::before {
        content: '';
        position: absolute;
        right: -100px; top: 50%;
        transform: translateY(-50%);
        width: 600px; height: 600px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(51,89,64,0.4) 0%, transparent 68%);
        pointer-events: none;
      }
      .gm-hero-inner {
        max-width: 1240px;
        width: 100%;
        margin: 0 auto;
        padding: 100px 56px;
        position: relative;
        z-index: 1;
      }
      .gm-hero-eyebrow {
        font-family: 'Thasadith', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: var(--gold);
        margin-bottom: 20px;
        display: block;
      }
      .gm-hero-h1 {
        font-size: clamp(44px, 6vw, 76px);
        color: var(--cream);
        margin: 0 0 20px;
        line-height: 0.95;
        max-width: 700px;
      }
      .gm-hero-h1 span { color: var(--gold); }
      .gm-hero-body {
        font-size: 18px;
        color: rgba(250,250,247,0.65);
        line-height: 1.65;
        margin: 0 0 40px;
        max-width: 540px;
      }
      .gm-coming-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(232,170,0,0.12);
        border: 1.5px solid rgba(232,170,0,0.4);
        border-radius: 6px;
        padding: 10px 20px;
        margin-bottom: 36px;
      }
      .gm-coming-badge-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        background: var(--gold);
        animation: pulse 2s infinite;
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
      }
      .gm-coming-badge span {
        font-family: 'Thasadith', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: var(--gold-light);
        letter-spacing: 0.03em;
      }
      .gm-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }

      /* ── SECTION ── */
      .gm-section { max-width: 1240px; margin: 0 auto; padding: 88px 56px; }
      .gm-section-head { margin-bottom: 48px; }
      .gm-section-head h2 { font-size: clamp(28px, 3.5vw, 44px); color: var(--text); margin: 8px 0 14px; }
      .gm-section-head p { font-size: 17px; color: var(--text-mid); line-height: 1.65; max-width: 580px; margin: 0; }

      /* ── WHAT ARE GUMMIES ── */
      .gm-explainer {
        background: var(--cream-warm);
        padding: 88px 0;
      }
      .gm-explainer-inner {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 56px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 72px;
        align-items: start;
      }
      .gm-explainer-text h2 { font-size: clamp(28px, 3.5vw, 40px); margin: 8px 0 20px; color: var(--text); }
      .gm-explainer-text p { font-size: 16px; color: var(--text-mid); line-height: 1.7; margin: 0 0 18px; }
      .gm-explainer-cards { display: flex; flex-direction: column; gap: 16px; }
      .gm-card {
        background: #fff;
        border: 1px solid var(--border-light);
        border-radius: 10px;
        padding: 24px 28px;
        transition: border-color 0.2s;
      }
      .gm-card:hover { border-color: var(--green-mid); }
      .gm-card-num {
        font-family: 'Thasadith', sans-serif;
        font-size: 11px;
        font-weight: 700;
        color: var(--gold);
        letter-spacing: 0.08em;
        display: block;
        margin-bottom: 6px;
      }
      .gm-card h3 { font-size: 17px; color: var(--text); margin: 0 0 8px; }
      .gm-card p { font-size: 14px; color: var(--text-mid); line-height: 1.6; margin: 0; }

      /* ── HOW THEY WORK ── */
      .gm-dark { background: var(--dark); padding: 88px 0; position: relative; overflow: hidden; }
      .gm-dark::after {
        content: '';
        position: absolute; top: -80px; right: -80px;
        width: 440px; height: 440px; border-radius: 50%;
        background: radial-gradient(circle, rgba(51,89,64,0.28) 0%, transparent 65%);
        pointer-events: none;
      }
      .gm-dark-inner { max-width: 1240px; margin: 0 auto; padding: 0 56px; position: relative; }
      .gm-dark h2 { color: var(--cream); font-size: clamp(28px, 3.5vw, 44px); margin: 8px 0 16px; }
      .gm-dark p.intro { font-size: 17px; color: rgba(250,250,247,0.6); line-height: 1.65; max-width: 580px; margin: 0 0 52px; }

      .gm-steps {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2px;
        background: rgba(255,255,255,0.05);
        border-radius: 10px;
        overflow: hidden;
      }
      .gm-step {
        background: rgba(255,255,255,0.03);
        padding: 32px 24px;
        border-right: 1px solid rgba(255,255,255,0.05);
      }
      .gm-step:last-child { border-right: none; }
      .gm-step-num {
        font-family: 'Thasadith', sans-serif;
        font-size: 40px;
        font-weight: 700;
        color: rgba(232,170,0,0.2);
        line-height: 1;
        margin-bottom: 12px;
      }
      .gm-step h3 { font-size: 16px; color: var(--cream); margin: 0 0 8px; }
      .gm-step p { font-size: 14px; color: rgba(250,250,247,0.55); line-height: 1.6; margin: 0; }
      .gm-dosing-note {
        margin-top: 32px;
        background: rgba(232,170,0,0.07);
        border: 1px solid rgba(232,170,0,0.2);
        border-radius: 8px;
        padding: 20px 28px;
        font-size: 14px;
        color: rgba(250,250,247,0.65);
        line-height: 1.65;
        max-width: 760px;
      }

      /* ── BUYING GUIDE ── */
      .gm-buying-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 48px;
      }
      .gm-buying-card {
        background: #fff;
        border: 1px solid var(--border-light);
        border-radius: 10px;
        padding: 28px 24px;
        transition: border-color 0.2s, box-shadow 0.2s;
      }
      .gm-buying-card:hover { border-color: var(--gold); box-shadow: 0 4px 20px rgba(232,170,0,0.1); }
      .gm-buying-icon {
        width: 44px; height: 44px;
        background: var(--cream-warm);
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 16px;
        font-size: 22px;
      }
      .gm-buying-card h3 { font-size: 16px; color: var(--text); margin: 0 0 10px; }
      .gm-buying-card p { font-size: 14px; color: var(--text-mid); line-height: 1.6; margin: 0; }

      /* ── BAKED PREVIEW ── */
      .gm-baked-preview {
        background: var(--green-deep);
        padding: 88px 0;
        position: relative;
        overflow: hidden;
      }
      .gm-baked-preview::before {
        content: '';
        position: absolute; bottom: -120px; right: -120px;
        width: 500px; height: 500px; border-radius: 50%;
        background: radial-gradient(circle, rgba(232,170,0,0.1) 0%, transparent 65%);
        pointer-events: none;
      }
      .gm-baked-inner {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 56px;
        display: grid;
        grid-template-columns: 1fr 400px;
        gap: 72px;
        align-items: center;
        position: relative;
      }
      .gm-baked-text h2 { font-size: clamp(28px, 3.5vw, 48px); color: var(--cream); margin: 8px 0 20px; }
      .gm-baked-text p { font-size: 17px; color: rgba(250,250,247,0.65); line-height: 1.65; margin: 0 0 20px; max-width: 500px; }
      .gm-baked-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 36px; }
      .gm-exist-products { display: flex; flex-direction: column; gap: 16px; }
      .gm-product-card {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px;
        padding: 20px 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: border-color 0.2s;
        text-decoration: none;
      }
      .gm-product-card:hover { border-color: rgba(232,170,0,0.5); }
      .gm-product-card-emoji { font-size: 28px; flex-shrink: 0; }
      .gm-product-card-info {}
      .gm-product-card-name { font-family: 'Thasadith', sans-serif; font-weight: 700; font-size: 15px; color: var(--cream); display: block; margin-bottom: 2px; }
      .gm-product-card-sub { font-size: 12px; color: rgba(250,250,247,0.45); }
      .gm-product-card-available {
        margin-left: auto;
        font-size: 10px;
        font-weight: 700;
        font-family: 'Thasadith', sans-serif;
        letter-spacing: 0.05em;
        padding: 4px 10px;
        border-radius: 20px;
        flex-shrink: 0;
      }
      .gm-available { background: rgba(51,89,64,0.5); color: #7ecb9a; }
      .gm-soon { background: rgba(232,170,0,0.15); color: var(--gold-light); }

      /* ── FAQ ── */
      .gm-faq-bg { background: var(--cream-warm); padding: 88px 0; }
      .gm-faq-wrap { max-width: 1240px; margin: 0 auto; padding: 0 56px; }
      .gm-faq-list { display: flex; flex-direction: column; gap: 6px; max-width: 780px; margin-top: 44px; }
      .gm-faq-item { background: #fff; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; transition: border-color 0.15s; }
      .gm-faq-item[open] { border-color: var(--green); }
      .gm-faq-q {
        display: flex; justify-content: space-between; align-items: center;
        padding: 20px 24px;
        font-weight: 600; font-size: 15px; color: var(--text);
        cursor: pointer; list-style: none;
        font-family: 'Noto Sans Thai', sans-serif;
        line-height: 1.4;
      }
      .gm-faq-q::-webkit-details-marker { display: none; }
      .gm-faq-chev { flex-shrink: 0; margin-left: 20px; }
      .gm-faq-chev svg { width: 18px; height: 18px; stroke: var(--green); fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.2s; }
      .gm-faq-item[open] .gm-faq-chev svg { transform: rotate(180deg); }
      .gm-faq-a { padding: 0 24px 20px; font-size: 15px; color: var(--text-mid); line-height: 1.7; }

      /* ── CTA ── */
      .gm-cta {
        background: var(--green); padding: 88px 56px; text-align: center;
        position: relative; overflow: hidden;
      }
      .gm-cta::before {
        content: ''; position: absolute; top: -50%; left: 50%; transform: translateX(-50%);
        width: 800px; height: 800px; border-radius: 50%;
        border: 1px solid rgba(232,170,0,0.15); pointer-events: none;
      }
      .gm-cta h2 { font-size: clamp(28px, 4.5vw, 52px); color: var(--cream); margin: 0 0 14px; position: relative; }
      .gm-cta p { font-size: 18px; color: rgba(250,250,247,0.75); margin: 0 auto 36px; max-width: 480px; position: relative; }
      .gm-cta-row { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; position: relative; }

      /* ── INTERNAL LINKS ── */
      .gm-links-band { background: var(--cream-warm); border-top: 1px solid var(--border-light); padding: 48px 0; }
      .gm-links-inner { max-width: 1240px; margin: 0 auto; padding: 0 56px; }
      .gm-links-inner p { font-size: 14px; color: var(--text-muted); margin: 0 0 16px; font-weight: 600; }
      .gm-link-row { display: flex; gap: 10px; flex-wrap: wrap; }
      .gm-link-chip {
        font-size: 13px; font-weight: 700;
        color: var(--green); border: 1px solid var(--border);
        padding: 8px 18px; border-radius: 20px;
        text-decoration: none; transition: all 0.15s;
        background: #fff;
      }
      .gm-link-chip:hover { background: var(--green); color: var(--cream); border-color: var(--green); }

      /* ── RESPONSIVE ── */
      @media (max-width: 900px) {
        .gm-hero-inner { padding: 72px 24px; }
        .gm-section { padding: 64px 24px; }
        .gm-explainer-inner { grid-template-columns: 1fr; gap: 40px; padding: 0 24px; }
        .gm-dark-inner { padding: 0 24px; }
        .gm-steps { grid-template-columns: 1fr 1fr; }
        .gm-buying-grid { grid-template-columns: 1fr 1fr; }
        .gm-baked-inner { grid-template-columns: 1fr; gap: 40px; padding: 0 24px; }
        .gm-faq-wrap { padding: 0 24px; }
        .gm-cta { padding: 72px 24px; }
        .gm-links-inner { padding: 0 24px; }
      }
      @media (max-width: 600px) {
        .gm-steps { grid-template-columns: 1fr; }
        .gm-buying-grid { grid-template-columns: 1fr; }
      }
    </style>
  </slot>

  <div class="gm-wrap">

    <!-- COMING SOON BANNER -->
    <div class="gm-coming-soon">
      <p>Baked Brand gummies are currently in development. <a href={lineUrl} target="_blank" rel="noopener noreferrer">Message us on LINE</a> to be notified when they launch.</p>
    </div>

    <!-- HERO -->
    <section class="gm-hero">
      <div class="gm-hero-inner">
        <span class="gm-hero-eyebrow">Cannabis edibles -- Thailand</span>
        <h1 class="gm-hero-h1">Cannabis<br><span>Gummies.</span></h1>
        <div class="gm-coming-badge">
          <div class="gm-coming-badge-dot"></div>
          <span>Coming Soon from Baked Brand</span>
        </div>
        <p class="gm-hero-body">Cannabis gummies are one of the most popular edible formats worldwide. We're developing a Thai FDA-approved microdose THC gummy made with the same full-spectrum infusion behind our cookies. Here's everything you need to know while you wait.</p>
        <div class="gm-hero-ctas">
          <a href={lineUrl} target="_blank" rel="noopener noreferrer" class="gm-btn gm-btn-gold">Notify me via LINE</a>
          <a href="#learn" class="gm-btn gm-btn-ghost">Learn more</a>
        </div>
      </div>
    </section>

    <!-- WHAT ARE CANNABIS GUMMIES -->
    <div id="learn" class="gm-explainer">
      <div class="gm-explainer-inner">
        <div class="gm-explainer-text">
          <span class="gm-label gm-label-green">What are cannabis gummies?</span>
          <h2>A popular, discreet, and precisely dosed edible format.</h2>
          <p>Cannabis gummies are gelatin- or pectin-based confections infused with cannabis extract. They're one of the most recognisable edible formats globally because they're easy to dose, discreet, and consistent in potency.</p>
          <p>Like all edibles, cannabis gummies are absorbed through the digestive system. This means effects take longer to feel than smoking -- typically 30 to 60 minutes -- but also last longer, often 2 to 4 hours.</p>
          <p>In Thailand, cannabis-infused food products must comply with Thai FDA regulations, including a maximum of 1.6mg THC per unit. This keeps Thai-market products firmly in microdose territory -- a dose range designed for mild, manageable effects.</p>
        </div>
        <div class="gm-explainer-cards">
          <div class="gm-card">
            <span class="gm-card-num">01</span>
            <h3>Chewy, familiar format</h3>
            <p>Gummies are recognisable, easy to carry, and simple to dose. No special equipment required.</p>
          </div>
          <div class="gm-card">
            <span class="gm-card-num">02</span>
            <h3>Slower onset than smoking</h3>
            <p>Digestion takes time. Effects typically begin in 30--60 minutes and last 2--4 hours. The most common mistake is redosing before the first dose has taken effect.</p>
          </div>
          <div class="gm-card">
            <span class="gm-card-num">03</span>
            <h3>Precise, repeatable dosing</h3>
