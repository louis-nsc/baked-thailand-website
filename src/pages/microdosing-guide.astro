---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleBody from '../components/sections/ArticleBody.astro';
import { lineUrl } from '../data/navigation';

const title = "Microdosing THC in Thailand: Beginner's Guide | Baked";
const description =
  "A complete guide to microdosing THC -- what it means, how much to take, and what to expect. Thailand's first Thai FDA-approved microdose edible, explained.";

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: "Microdosing THC: The Complete Beginner's Guide",
    description,
    image: 'https://bakedthailand.com/images/logo-color.png',
    datePublished: '2026-07-17',
    author: { '@type': 'Organization', name: 'Baked Brand Edibles in Thailand' },
    publisher: {
      '@type': 'Organization',
      name: 'Baked Brand Edibles in Thailand',
      logo: { '@type': 'ImageObject', url: 'https://bakedthailand.com/images/logo-color.png' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bakedthailand.com/' },
      { '@type': 'ListItem', position: 2, name: 'Microdosing Guide', item: 'https://bakedthailand.com/microdosing-guide/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is a microdose of THC?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A microdose is typically 1--2.5mg of THC -- well below the threshold for psychoactive effects. At this level most people feel relaxed and clear-headed rather than high.',
        },
      },
      {
        '@type': 'Question',
        name: 'How long does a microdose edible take to kick in?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Edibles typically take 45--90 minutes to take effect. Always wait at least two hours before considering a second dose.',
        },
      },
    ],
  },
];

const sections = [
  {
    h2: "What is microdosing THC?",
    html: "Microdosing means taking the smallest amount needed to feel a benefit -- without getting high. For THC, that's typically 1--2.5mg per dose. At this level, most people report feeling calmer, more focused, and less anxious without any impairment.",
  },
  {
    h2: "Why edibles are ideal for microdosing",
    html: "Edibles deliver a precise, measurable dose every time. Smoking and vaping make it nearly impossible to know exactly how much THC you're consuming. Baked cookies and caramels each contain up to 1.6mg THC -- a consistent, lab-tested amount that makes it easy to start low and find your level.",
  },
  {
    h2: "How to start: the low-and-slow approach",
    html: "Take one Baked cookie or caramel. Wait at least two hours before deciding if you want more. Edibles take longer to kick in than most people expect -- the two-hour rule prevents you from accidentally taking too much.",
  },
  {
    h2: "What to expect at 1.6mg THC",
    html: "Most first-timers describe a subtle lift in mood, mild body relaxation, and a sense of calm. Effects typically last 3--5 hours. At this dose level you should be able to work, socialize, and go about your day normally.",
  },
  {
    h2: "Is microdosing THC legal in Thailand?",
    html: "Yes. Baked Brand is Thailand's first and only brand to hold Thai FDA approval specifically for microdose THC edibles. Our products are legal for adults aged 20 and over. <a href='/cannabis-legal-thailand/'>Read more about cannabis law in Thailand &rarr;</a>",
  },
  {
    h2: "Order from anywhere in Thailand",
    html: `Baked cookies and caramels ship across Thailand. Same-day delivery in Chiang Mai. Order on LINE: <a href="${lineUrl}" target="_blank" rel="noopener">@baked.brand.edibles</a>.`,
  },
];
---

<BaseLayout title={title} description={description} structuredData={structuredData} canonicalUrl="https://bakedthailand.com/microdosing-guide/">
  <Fragment slot="head">
    {structuredData.map((sd) => <script type="application/ld+json" set:html={JSON.stringify(sd)} />)}
  </Fragment>
  <ArticleBody
    eyebrow="THAI FDA APPROVED"
    h1="Microdosing THC in Thailand: The Complete Guide"
    sub="Thailand's first Thai FDA-approved microdose THC edibles. Up to 1.6mg THC per cookie, lab-tested, made in Chiang Mai."
    sections={sections}
    ctaLabel="Order on LINE"
  />
</BaseLayout>
