---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleBody from '../components/sections/ArticleBody.astro';

const title = 'What Are Edibles Like? What to Expect | Baked Brand';
const description =
  'Curious what a THC edible actually feels like? What to expect from a measured microdose, and how it differs from smoking.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'What Are Edibles Like?',
  description,
  image: 'https://bakedthailand.com/images/logo-color.png',
  datePublished: '2026-07-17',
  author: { '@type': 'Organization', name: 'Baked Brand Edibles in Thailand' },
  publisher: {
    '@type': 'Organization',
    name: 'Baked Brand Edibles in Thailand',
    logo: { '@type': 'ImageObject', url: 'https://bakedthailand.com/images/logo-color.png' },
  },
};

const sections = [
  {
    h2: 'A slower, longer effect',
    html: 'Unlike smoking, edibles take 45--90 minutes to kick in, and the effect lasts significantly longer once it does. Most people describe it as a gradual sense of ease rather than a sudden shift.',
  },
  {
    h2: 'At a microdose specifically',
    html: 'At Baked\'s 1.6mg THC dose, most people report a mild, manageable effect -- not the intensity associated with a large recreational dose. It\'s designed to be felt, not overwhelming.',
  },
  {
    h2: 'Start low, especially the first time',
    html: 'However experienced you are with smoking, start low with edibles and wait before taking more. The delay is the most common reason people overconsume.',
  },
  {
    h2: 'Common first-time experiences',
    html: 'Relaxation, mild mood lift, and reduced anxiety are the most reported effects from a microdose. Some people also report improved focus or creativity.',
  },
  {
    h2: 'What it is not',
    html: 'A microdose edible is not a recreational dose. At 1.6mg THC, most adults will feel a subtle effect that does not impair daily functioning. This is intentional.',
  },
];
---

<BaseLayout title={title} description={description} structuredData={structuredData} canonicalUrl={`https://bakedthailand.com/${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}/`}>
  <ArticleBody
    eyebrow="THAI FDA APPROVED"
    h1={title}
    sub="Thailand's only Thai FDA-approved microdose THC edibles. Up to 1.6mg THC per piece, lab-tested, made in our own factory."
    sections={sections}
    ctaLabel="Order on LINE"
    shopeeLabel="Learn More"
  />
</BaseLayout>
