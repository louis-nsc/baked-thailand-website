---
import BaseLayout from '../layouts/BaseLayout.astro';
import { lineUrl } from '../data/navigation';

const title = 'Wholesale Order Received - Baked Brand Edibles in Thailand';
const description =
  'Thanks for your wholesale inquiry — our team will follow up shortly. Questions in the meantime? Message us via LINE anytime: @baked';
---

<BaseLayout title={title} description={description}>
  <section class="bk-confirmation">
    <h1>&#9989; Wholesale Order Received!</h1>
    <p>Thanks for your order &mdash; our team will be in touch shortly to confirm details.</p>
    <p class="bk-sub">Questions in the meantime? Message us via LINE anytime.</p>
    <a class="bk-cta" href={lineUrl} target="_blank" rel="noopener">Chat on LINE &rarr;</a>
  </section>
</BaseLayout>

<style>
  .bk-confirmation {
    max-width: 600px;
    margin: 0 auto;
    padding: 80px 48px 96px;
    text-align: center;
  }
  .bk-confirmation h1 {
    font-size: clamp(1.7rem, 2.8vw, 2.3rem);
    margin: 0 0 16px;
  }
  .bk-confirmation p {
    color: var(--ink-soft);
    margin: 0 0 8px;
    font-size: 1.05rem;
  }
  .bk-confirmation .bk-sub {
    margin: 0 0 28px;
  }

  @media (max-width: 780px) {
    .bk-confirmation { padding: 56px 24px 64px; }
  }
</style>
