---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VenuePageBody from '../../../components/sections/VenuePageBody.astro';
import { venueTypes } from '../../../data/venueTypes';

const venue = venueTypes.find((v) => v.slug === 'markets-and-supermarkets')!;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'ขายส่งขนมกัญชาไมโครโดสสำหรับตลาดและซูเปอร์มาร์เก็ต',
    provider: { '@type': 'LocalBusiness', name: 'Baked Brand Edibles in Thailand' },
    description: venue.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: 'https://bakedthailand.com/' },
      { '@type': 'ListItem', position: 2, name: 'สำหรับธุรกิจ', item: 'https://bakedthailand.com/th/business/' },
      { '@type': 'ListItem', position: 3, name: 'ตลาดและซูเปอร์มาร์เก็ต', item: 'https://bakedthailand.com/th/business/markets-and-supermarkets/' },
    ],
  },
];
---

<BaseLayout title={venue.title} description={venue.description} lang="th">
  <Fragment slot="head">
    {structuredData.map((sd) => <script type="application/ld+json" set:html={JSON.stringify(sd)} />)}
  </Fragment>
  <VenuePageBody venue={venue} />
</BaseLayout>
