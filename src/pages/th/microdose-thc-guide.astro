---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { lineUrl } from '../../data/navigation';

const title = 'กัญชาไมโครโดสคืออะไร? คู่มือสำหรับผู้เริ่มต้น | Baked Brand';
const description =
  'ไมโครโดส THC คืออะไร ควรเริ่มที่ปริมาณเท่าไหร่ และควรคาดหวังผลอย่างไร คู่มือฉบับสมบูรณ์จาก Baked Brand ผู้ผลิตขนมกัญชาไมโครโดสที่ผ่านการรับรองจาก อย. ไทยรายแรก';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    image: 'https://bakedthailand.com/images/logo-color.png',
    datePublished: '2026-07-17',
    author: { '@type': 'Organization', name: 'Baked Brand Edibles in Thailand' },
    publisher: {
      '@type': 'Organization',
      name: 'Baked Brand Edibles in Thailand',
      logo: { '@type': 'ImageObject', url: 'https://bakedthailand.com/images/logo-color.png' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: 'https://bakedthailand.com/' },
      { '@type': 'ListItem', position: 2, name: title, item: `https://bakedthailand.com/th/${title}/` },
    ],
  },
];
---

<BaseLayout title={title} description={description} structuredData={structuredData} lang="th">
  <section class="bk-hero">
    <div>
      <p class="bk-eyebrow">ผ่านการรับรองจาก อย. ไทย</p>
      <h1>{title}</h1>
      <p class="bk-sub">{description}</p>
      <div class="bk-cta-row">
        <a class="bk-cta-primary" href="https://page.line.me/baked" target="_blank" rel="noopener">สั่งซื้อผ่าน LINE</a>
      </div>
    </div>
  </section>
</BaseLayout>
