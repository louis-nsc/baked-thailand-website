---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { lineUrl } from '../../data/navigation';

const title = 'ประโยชน์ของกัญชา: การศึกษาเชิงวิชาการ | Baked Brand';
const description =
  'เรียนรู้เพิ่มเติมเกี่ยวกับประโยชน์ของกัญชาจากมุมมองทางวิทยาศาสตร์ และทำความเข้าใจว่า Baked Brand ผลิตขนมกัญชาที่ถูกกฎหมายและปลอดภัยอย่างไร';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: 'https://bakedthailand.com/images/logo-color.png',
  datePublished: '2026-07-17',
  author: { '@type': 'Organization', name: 'Baked Brand Edibles in Thailand' },
  publisher: {
    '@type': 'Organization',
    name: 'Baked Brand Edibles in Thailand',
    logo: { '@type': 'ImageObject', url: 'https://bakedthailand.com/images/logo-color.png' },
  },
};
---

<BaseLayout title={title} description={description} lang="th">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <section class="bk-article-hero">
    <p class="bk-eyebrow">ผ่านการรับรองจาก อย. ไทย</p>
    <h1>ประโยชน์ของกัญชา: การศึกษาเชิงวิชาการ</h1>
    <p class="bk-sub">{description}</p>
  </section>

  <article class="bk-article-body">
    <section>
      <h2>กัญชาในงานวิจัยทางการแพทย์</h2>
      <p>
        งานวิจัยทางการแพทย์เกี่ยวกับกัญชายังคงพัฒนาต่อเนื่อง มีการศึกษาที่บ่งชี้ว่า cannabinoids อาจมีคุณสมบัติในการลดการอักเสบ บรรเทาอาการปวด และปรับปรุงคุณภาพการนอนหลับ
      </p>
    </section>

    <section>
      <h2>ระบบ Endocannabinoid</h2>
      <p>
        ร่างกายมนุษย์มีระบบ Endocannabinoid ที่รองรับการทำงานของ THC และ CBD ซึ่งเป็นสาเหตุที่สารประกอบจากกัญชาสามารถออกฤทธิ์ต่อร่างกายได้หลากหลายรูปแบบ
      </p>
    </section>

    <section>
      <h2>ข้อควรทราบ</h2>
      <p>
        การศึกษาด้านกัญชายังอยู่ในระยะเริ่มต้น และผลลัพธ์ในแต่ละบุคคลอาจแตกต่างกัน Baked Brand ผลิตขนมไมโครโดสที่ผ่านการรับรองจาก อย. ให้ผลที่สม่ำเสมอและวัดได้
      </p>
      <div class="bk-cta-row">
        <a class="bk-cta-primary" href={lineUrl} target="_blank" rel="noopener">สั่งซื้อผ่าน LINE</a>
      </div>
    </section>
  </article>
</BaseLayout>
