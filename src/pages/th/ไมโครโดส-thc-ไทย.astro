---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { lineUrl } from '../../data/navigation';

const title = 'ไมโครโดส THC คืออะไร? คู่มือสำหรับคนไทย (2026) | Baked Brand';
const description =
  'ไมโครโดส THC คืออะไร เหมาะกับใคร และควรเริ่มต้นอย่างไรให้ปลอดภัย คู่มือฉบับพื้นฐานสำหรับคนไทยที่สนใจอาหารผสมกัญชาแบบวัดปริมาณได้';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'ไมโครโดส THC คืออะไร? คู่มือสำหรับคนไทย',
  description,
  image: 'https://bakedthailand.com/images/logo-color.png',
  datePublished: '2026-07-17',
  author: { '@type': 'Organization', name: 'Baked Brand Edibles in Thailand' },
  publisher: {
    '@type': 'Organization',
    name: 'Baked Brand Edibles in Thailand',
    logo: { '@type': 'ImageObject', url: 'https://bakedthailand.com/images/logo-color.png' },
  },
};
---

<BaseLayout title={title} description={description} lang="th">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <section class="bk-article-hero">
    <p class="bk-eyebrow">ผ่านการรับรองจาก อย. ไทย</p>
    <h1>ไมโครโดส THC คืออะไร?</h1>
    <p class="bk-sub">{description}</p>
  </section>

  <article class="bk-article-body">
    <section>
      <h2>ไมโครโดสคืออะไร</h2>
      <p>
        "ไมโครโดส" หมายถึงการทาน THC ในปริมาณต่ำมาก เพื่อให้รู้สึกผ่อนคลายเล็กน้อยโดยไม่มีผลข้างเคียงที่รุนแรง ปริมาณไมโครโดสทั่วไปคือ 1-5mg THC ต่อครั้ง
      </p>
    </section>

    <section>
      <h2>ทำไมถึงนิยมไมโครโดส</h2>
      <p>
        ไมโครโดสช่วยให้ผู้ใช้สามารถควบคุมประสบการณ์ได้ดีกว่า โดยเฉพาะผู้ที่เพิ่งเริ่มต้น หรือผู้ที่ต้องการผลในระดับที่ไม่กระทบต่อการทำงานหรือกิจวัตรประจำวัน
      </p>
    </section>

    <section>
      <h2>คุกกี้และคาราเมล Baked Brand</h2>
      <p>
        คุกกี้ Baked Brand มี THC สูงสุด 1.6mg ต่อชิ้น ผ่านการรับรองจาก อย. ไทย เป็นตัวเลือกที่เหมาะสมสำหรับการทดลองไมโครโดสครั้งแรก เพราะรู้ว่ารับประทานปริมาณเท่าไรอย่างแน่นอน
      </p>
      <div class="bk-cta-row">
        <a class="bk-cta-primary" href={lineUrl} target="_blank" rel="noopener">สั่งซื้อผ่าน LINE</a>
      </div>
    </section>
  </article>
</BaseLayout>
