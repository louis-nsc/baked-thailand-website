---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { lineUrl } from '../../data/navigation';

const title = 'คุกกี้กัญชาไมโครโดส 1.6mg THC | Baked Brand ผ่านการรับรอง อย.';
const description =
  'คุกกี้กัญชาไมโครโดส THC สูงสุด 1.6mg ต่อชิ้น ผ่านการรับรองจาก อย. ไทย ผ่านการทดสอบในห้องปฏิบัติการ ปลอดภัย ถูกกฎหมาย จัดส่งทั่วประเทศ';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'คุกกี้กัญชาไมโครโดส Baked Brand',
    description,
    image: 'https://bakedthailand.com/images/soft-cookies.png',
    brand: { '@type': 'Brand', name: 'Baked Brand' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: 'https://bakedthailand.com/' },
      { '@type': 'ListItem', position: 2, name: 'คุกกี้กัญชา', item: 'https://bakedthailand.com/th/thc-cookie-guide/' },
    ],
  },
];
---

<BaseLayout title={title} description={description} lang="th">
  <Fragment slot="head">
    {structuredData.map((sd) => <script type="application/ld+json" set:html={JSON.stringify(sd)} />)}
  </Fragment>

  <section class="bk-article-hero">
    <p class="bk-eyebrow">ผ่านการรับรองจาก อย. ไทย</p>
    <h1>คุกกี้กัญชาไมโครโดส Baked Brand</h1>
    <p class="bk-sub">
      THC สูงสุด 1.6mg ต่อชิ้น ผ่านการรับรองจาก อย. ไทย ปลอดภัย ถูกกฎหมาย
    </p>
  </section>

  <article class="bk-article-body">
    <section>
      <h2>คุกกี้กัญชา Baked Brand คืออะไร?</h2>
      <p>
        คุกกี้กัญชาไมโครโดสของ Baked Brand เป็นขนมที่มี THC สูงสุด 1.6mg ต่อชิ้น ผลิตจากพืชกัญชาสายพันธุ์ไฮบริดที่พัฒนาโดยมหาวิทยาลัยแม่โจ้ ใช้กระบวนการสกัดจากใบและกิ่งก้านทั้งหมด ไม่ใช่สารสกัดเข้มข้น
      </p>
      <p>
        ผลิตภัณฑ์ทุกชิ้นผ่านการรับรองจากสำนักงานคณะกรรมการอาหารและยา (อย.) ของประเทศไทย และผ่านการทดสอบในห้องปฏิบัติการอย่างเข้มงวด
      </p>
    </section>

    <section>
      <h2>ทำไมต้องเลือก Baked Brand?</h2>
      <ul>
        <li>ผ่านการรับรอง อย. ไทย อย่างเป็นทางการ</li>
        <li>THC 1.6mg ต่อชิ้น ปริมาณแน่นอน ไม่ผันแปร</li>
        <li>ใช้กัญชาแบบ Full-Spectrum จากมหาวิทยาลัยแม่โจ้</li>
        <li>ไม่ใช้สารสกัดเข้มข้นหรือสารเคมีสังเคราะห์</li>
        <li>เหมาะสำหรับผู้เริ่มต้นและผู้ใช้งานประจำ</li>
        <li>จัดส่งทั่วไทย ผ่าน LINE</li>
      </ul>
    </section>

    <section>
      <h2>วิธีรับประทานที่เหมาะสม</h2>
      <p>
        สำหรับผู้เริ่มต้น แนะนำให้เริ่มที่ครึ่งชิ้น (ประมาณ 0.8mg THC) และรอผล 60-90 นาที ก่อนรับประทานเพิ่ม ผลของ THC จากการรับประทานจะออกฤทธิ์ช้ากว่าการสูบ แต่นานกว่า
      </p>
    </section>

    <section>
      <h2>สั่งซื้อได้ที่ไหน?</h2>
      <p>
        สั่งซื้อผ่าน LINE ได้เลย จัดส่งไปยังกรุงเทพฯ เชียงใหม่ ภูเก็ต พัทยา เกาะสมุย และพื้นที่อื่นๆ ทั่วประเทศ
      </p>
      <div class="bk-cta-row">
        <a class="bk-cta-primary" href={lineUrl} target="_blank" rel="noopener">สั่งซื้อผ่าน LINE</a>
      </div>
    </section>
  </article>
</BaseLayout>
