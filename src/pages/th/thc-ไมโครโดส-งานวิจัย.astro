---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { lineUrl } from '../../data/navigation';

const title = 'THC ไมโครโดส: งานวิจัยที่ผ่านการตรวจสอบ | Baked Brand';
const description =
  'สำรวจแนวทางงานวิจัยเกี่ยวกับ THC ไมโครโดส ครอบคลุมประเด็นการนอนหลับ ความเครียด และระบบ Endocannabinoid พร้อมข้อควรระวังในการตีความข้อมูลทางวิทยาศาสตร์';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: 'https://bakedthailand.com/images/logo-color.png',
  datePublished: '2026-07-17',
  author: { '@type': 'Organization', name: 'Baked Brand Edibles in Thailand' },
  publisher: {
    '@type': 'Organization',
    name: 'Baked Brand Edibles in Thailand',
    logo: { '@type': 'ImageObject', url: 'https://bakedthailand.com/images/logo-color.png' },
  },
};
---

<BaseLayout title={title} description={description} lang="th">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <section class="bk-article-hero">
    <p class="bk-eyebrow">ผ่านการรับรองจาก อย. ไทย</p>
    <h1>THC ไมโครโดส: งานวิจัยที่ผ่านการตรวจสอบ</h1>
    <p class="bk-sub">{description}</p>
  </section>

  <article class="bk-article-body">
    <section>
      <h2>ระบบ Endocannabinoid คืออะไร</h2>
      <p>
        ร่างกายมนุษย์มีระบบ Endocannabinoid ที่ทำหน้าที่ควบคุมความสมดุลในหลายด้าน ทั้งอารมณ์ การนอนหลับ และการตอบสนองต่อความเจ็บปวด THC จับกับตัวรับในระบบนี้ ซึ่งเป็นสาเหตุที่ทำให้เกิดผลต่อร่างกายและจิตใจ
      </p>
    </section>

    <section>
      <h2>งานวิจัยด้านไมโครโดส</h2>
      <p>
        งานวิจัยเกี่ยวกับ THC ไมโครโดสยังอยู่ในระยะเริ่มต้น แต่มีการศึกษาที่ชี้ว่าปริมาณต่ำอาจช่วยลดความเครียดและปรับปรุงคุณภาพการนอนหลับในบางกลุ่มประชากร โดยไม่ก่อให้เกิดผลข้างเคียงที่รุนแรง
      </p>
    </section>

    <section>
      <h2>ข้อควรระวัง</h2>
      <p>
        การตีความงานวิจัยควรทำด้วยความระมัดระวัง เนื่องจากผลลัพธ์อาจแตกต่างกันในแต่ละบุคคล ปัจจัยเช่น น้ำหนักตัว ความทนทาน และสุขภาพโดยรวมล้วนมีผลต่อประสบการณ์
      </p>
      <div class="bk-cta-row">
        <a class="bk-cta-primary" href={lineUrl} target="_blank" rel="noopener">สั่งซื้อผ่าน LINE</a>
      </div>
    </section>
  </article>
</BaseLayout>
