---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Privacy Policy - Baked Brand Edibles in Thailand';
const description = "Baked Brand's privacy policy — how we collect, use, and protect your personal information on bakedthailand.com.";
---

<BaseLayout title={title} description={description}>
  <article class="bk-legal">
    <h1>Privacy Policy</h1>
    <p class="bk-effective-date">Effective Date: [07/05/2025]</p>

    <p>At Baked (&ldquo;we,&rdquo; &ldquo;our,&rdquo; or &ldquo;us&rdquo;), your privacy is important to us. This Privacy Policy explains how we collect, use, and protect your personal information when you visit our website, bakedthailand.com.</p>

    <h2>1. Information We Collect</h2>
    <p>We may collect the following types of information:</p>
    <p><strong>Personal Information:</strong> When you contact us, sign up for updates, or place an order, we may collect your name, email address, phone number, delivery address, and any other information you provide.</p>
    <p><strong>Non-Personal Information:</strong> We may collect browser data, IP address, and other technical information through cookies and analytics tools to help us improve our website.</p>

    <h2>2. How We Use Your Information</h2>
    <p>We use the information we collect to:</p>
    <ul>
      <li>Process and deliver orders</li>
      <li>Respond to customer inquiries</li>
