---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleBody from '../components/sections/ArticleBody.astro';

const title = 'Why Are Stoners So Chill? The Science of It | Baked Brand';
const description =
  'There\'s a real reason cannabis has a relaxed reputation — here\'s the science behind it, and how a microdose fits into a calm, low-key experience.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Why Are Stoners So Chill?',
  description,
  image: 'https://bakedthailand.com/images/logo-color.png',
  datePublished: '2026-07-17',
  author: { '@type': 'Organization', name: 'Baked Brand Edibles in Thailand' },
  publisher: {
    '@type': 'Organization',
    name: 'Baked Brand Edibles in Thailand',
    logo: { '@type': 'ImageObject', url: 'https://bakedthailand.com/images/logo-color.png' },
  },
};

const sections = [
  {
    h2: 'THC and relaxation',
    html: 'THC interacts with the body\'s endocannabinoid system, which plays a role in mood and stress response. At lower doses, many people report a sense of ease rather than intense psychoactive effects.',
  },
  {
    h2: 'Dose changes the experience a lot',
    html: 'A large dose can just as easily produce anxiety as calm — the "chill" reputation really applies at lower, controlled doses. That\'s the whole idea behind a microdose: a light, manageable effect rather than an intense one.',
  },
  {
    h2: 'Baked\'s take on it',
    html: 'Our cookies and caramels contain up to 1.6mg THC per piece — a measured microdose designed for a subtle, easy effect. The kind of calm that fits into a normal day.',
  },
];
---

<BaseLayout title={title} description={description} structuredData={structuredData} canonicalUrl={`https://bakedthailand.com/${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}/`}>
  <ArticleBody
    eyebrow="THAI FDA APPROVED"
    h1={title}
    sub="Thailand's only Thai FDA-approved microdose THC edibles. Up to 1.6mg THC per piece, lab-tested, made in our own factory."
    sections={sections}
    ctaLabel="Order on LINE"
    shopeeLabel="Learn More"
  />
</BaseLayout>
