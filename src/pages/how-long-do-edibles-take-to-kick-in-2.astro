---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleBody from '../components/sections/ArticleBody.astro';

const title = 'How Long Do Edibles Take to Kick In? Thailand Guide 2026';
const description =
  'Edibles typically take 45–90 minutes to kick in. Here’s what affects onset time, and what to expect from a 1.6mg THC microdose.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'How Long Do Edibles Take to Kick In?',
  description,
  image: 'https://bakedthailand.com/images/logo-color.png',
  datePublished: '2026-07-17',
  author: { '@type': 'Organization', name: 'Baked Brand Edibles in Thailand' },
  publisher: {
    '@type': 'Organization',
    name: 'Baked Brand Edibles in Thailand',
    logo: { '@type': 'ImageObject', url: 'https://bakedthailand.com/images/logo-color.png' },
  },
};

const sections = [
  {
    h2: 'The typical window: 45–90 minutes',
    html: 'Unlike smoking, where effects are near-immediate, edibles have to be digested first — THC is absorbed through the gut and processed by the liver before it takes effect. Most people feel something within 45 to 90 minutes, though it can take longer.',
  },
  {
    h2: 'What affects onset time',
    html: 'Whether you\'ve eaten recently, your metabolism, and the dose itself all affect how quickly you feel an edible. Taking one on an empty stomach may work faster; taking one after a meal may be slower and gentler.',
  },
  {
    h2: 'What not to do',
    html: 'Do not take a second piece because you do not feel anything yet. The most common mistake with edibles is redosing too early. Wait at least 90 minutes before considering more.',
  },
];
---

<BaseLayout title={title} description={description} structuredData={structuredData} canonicalUrl={`https://bakedthailand.com/${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}/`}>
  <ArticleBody
    eyebrow="THAI FDA APPROVED"
    h1={title}
    sub="Thailand's only Thai FDA-approved microdose THC edibles. Up to 1.6mg THC per piece, lab-tested, made in our own factory."
    sections={sections}
    ctaLabel="Order on LINE"
    shopeeLabel="Learn More"
  />
</BaseLayout>
