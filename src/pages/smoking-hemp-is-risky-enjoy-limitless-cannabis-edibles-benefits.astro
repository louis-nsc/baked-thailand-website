---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleBody from '../components/sections/ArticleBody.astro';

const title = 'Why Edibles Instead of Smoking Hemp? | Baked Brand';
const description =
  'Smoking hemp or cannabis carries respiratory risks that edibles avoid entirely. Here\'s why more people are switching to a measured, lab-tested edible instead.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Why Edibles Instead of Smoking Hemp?',
  description,
  image: 'https://bakedthailand.com/images/logo-color.png',
  datePublished: '2026-07-17',
  author: { '@type': 'Organization', name: 'Baked Brand Edibles in Thailand' },
  publisher: {
    '@type': 'Organization',
    name: 'Baked Brand Edibles in Thailand',
    logo: { '@type': 'ImageObject', url: 'https://bakedthailand.com/images/logo-color.png' },
  },
};

const sections = [
  {
    h2: 'Smoking carries risks edibles don\'t',
    html: 'Inhaling any combusted plant material — hemp included — carries respiratory risks that have nothing to do with THC itself. Edibles avoid that entirely.',
  },
  {
    h2: 'A more controllable dose',
    html: 'A lab-tested edible with a stated THC content gives you a known, repeatable amount every time. Baked\'s cookies and caramels are up to 1.6mg THC per piece, formulated as a microdose.',
  },
  {
    h2: 'Legal and lab-tested',
    html: 'Baked products are Thai FDA-approved and unaffected by the 2026 crackdown on unregulated cannabis. Clearly legal for adults aged 20 and over.',
  },
];
---

<BaseLayout title={title} description={description} structuredData={structuredData} canonicalUrl={`https://bakedthailand.com/${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}/`}>
  <ArticleBody
    eyebrow="THAI FDA APPROVED"
    h1={title}
    sub="Thailand's only Thai FDA-approved microdose THC edibles. Up to 1.6mg THC per piece, lab-tested, made in our own factory."
    sections={sections}
    ctaLabel="Order on LINE"
    shopeeLabel="Learn More"
  />
</BaseLayout>
