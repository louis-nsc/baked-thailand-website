---
import { lineUrl } from '../../data/navigation';

interface Section {
  h2: string;
  html: string;
}

interface Props {
  eyebrow: string;
  h1: string;
  sub: string;
  sections: Section[];
  ctaLabel?: string;
  shopeeLabel?: string;
  showShopee?: boolean;
}

const { eyebrow, h1, sub, sections, ctaLabel = 'Chat on LINE', shopeeLabel = 'Order on LINE', showShopee = true } = Astro.props;
---

<section class="bk-article-hero">
  <p class="bk-eyebrow">{eyebrow}</p>
  <h1>{h1}</h1>
  <p class="bk-sub">{sub}</p>
</section>

<article class="bk-article-body">
  {sections.map((s) => (
    <section>
      <h2>{s.h2}</h2>
      <p set:html={s.html} />
    </section>
  ))}
</article>

<div class="bk-cta-band">
  <a class="bk-cta" href={lineUrl} target="_blank" rel="noopener">{ctaLabel} &rarr;</a>
  {showShopee && <a class="bk-cta-secondary" href={lineUrl} target="_blank" rel="noopener">{shopeeLabel}</a>}
</div>

<style>
  .bk-article-hero {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 48px 32px;
    text-align: center;
  }
  .bk-article-hero .bk-eyebrow { justify-content: center; }
  .bk-article-hero h1 {
    font-weight: 700;
    font-size: clamp(1.7rem, 2.8vw, 2.4rem);
    margin: 0 0 16px;
  }
  .bk-article-hero .bk-sub {
    font-size: 1.05rem;
    color: var(--ink-soft);
  }

  .bk-article-body {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 48px 40px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .bk-article-bod